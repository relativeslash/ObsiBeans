{
  "name": "obsibeans",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.8.1"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "deps": "yarn install --immutable && yarn constraints && yarn dedupe --check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint --max-warnings 0 .",
    "fitness": "node tools/type-size.ts && node tools/architecture.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage && node tools/changed-coverage.ts",
    "verify": "yarn deps && yarn typecheck && yarn lint && yarn fitness && yarn coverage",
    "build": "vite build",
    "test:native": "yarn build && node test/native/smoke.ts"
  },
  "dependencies": {
    "intl-messageformat": "catalog:",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@eslint/js": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "obsidian": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
